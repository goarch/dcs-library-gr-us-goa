ruLI.Rubric_001a.text = "Ὁ Διάκονος, λαβὼν εὐλογίαν παρὰ τοῦ ἱερουργοῦντος Ἱερέως, ἐξέρχεται τοῦ ἁγίου Βήματος, διὰ τῆς βορείου Πύλης, καὶ ἱστάμενος ἐν τῷ Σολέᾳ, πρὸ τῆς Ὡραίας Πύλης, ἐστραμμένος πρὸς ἀνατολὰς καὶ κρατῶν τὸ ὀράριον ἐν τῇ δεξιᾷ χειρί, ἀποκαλύπτεται καί, προσκυνήσας τρὶς μετʼ εὐλαβείας, ἐκφωνεῖ·"
ruLI.Rubric_002a.text = "Ὁ Ἱερεύς, ἱστάμενος πρὸ τῆς ἁγίας Τραπέζης ἀσκεπής, προσκυνεῖ τρὶς καί, ὑψῶν τὸ ἱερὸν Εὐαγγέλιον καὶ ποιῶν διʼ αὐτοῦ τύπον σταυροῦ ἐπὶ τοῦ συνεπτυγμένου εἰλητοῦ, ἐκφωνεῖ·"
ruLI.Rubric_003a.text = "Ὁ Διάκονος, ἐπανατιθεὶς ἐπὶ τῆς κεφαλῆς αὐτοῦ τὸ κάλυμμα, ἐκφωνεῖ τὰ Εἰρηνικὰ ἢ τὴν λεγομένην μεγάλην Συναπτήν· εἰ δʼ οὐκ ἔστιν, ὁ Ἱερεύς· τῶν Χορῶν ψαλλόντων ἐναλλὰξ μεθʼ ἑκάστην δέησιν τό· Κύριε, ἐλέησον, ἅπαξ."
ruLI.Rubric_004a.text = "Ὁ Ἱερεύς, ἐν εὐλαβείᾳ πρὸ τῆς ἁγίας Τραπέζης ἱστάμενος, ἀναγινώσκει τὴν εὐχὴν τοῦ Ἀντιφώνου·"
ruLI.Rubric_005a.text = "Καὶ ψάλλεται παρὰ τῶν Χορῶν τὸ Αʹ Ἀντίφωνον ἢ ἡ Αʹ Στάσις τῶν Τυπικῶν."
ruLI.Rubric_006a.text = "Ὁ Διάκονος προσκυνήσας μεθίσταται τοῦ τόπου αὐτοῦ καὶ ἀπελθὼν ἵσταται ἐνώπιον τῆς εἰκόνος τῆς Θεοτόκου, βλέπων πρὸς τὴν εἰκόνα τοῦ Χριστοῦ."
ruLI.Rubric_007a.text = "Μετὰ δὲ τὴν συμπλήρωσιν τοῦ Ἀντιφώνου, ἐλθὼν ὁ Διάκονος καὶ στὰς ἐν τῷ συνήθει τόπῳ ἐκφωνεῖ τὴν μικρὰν Συναπτήν·"
ruLI.Rubric_008a.text = "Ὁ Ἱερεὺς ἀναγινώσκει τὴν εὐχὴν τοῦ Ἀντιφώνου·"
ruLI.Rubric_009a.text = "Ὁ Ἱερεὺς ἐκφώνως·"
ruLI.Rubric_010a.text = "Καὶ ψάλλεται ὁμοίως παρὰ τῶν Χορῶν τὸ Βʹ Ἀντίφωνον ἢ ἡ Βʹ Στάσις τῶν Τυπικῶν."
ruLI.Rubric_011a.text = "Ὁ δὲ Διάκονος προσκυνήσας μεθίσταται καὶ αὖθις τοῦ τόπου αὐτοῦ καὶ ἀπελθὼν ἵσταται ἐνώπιον τῆς εἰκόνος τοῦ Χριστοῦ, βλέπων πρὸς τὴν εἰκόνα τῆς Θεοτόκου."
ruLI.Rubric_012a.text = "Μετὰ δὲ τὴν συμπλήρωσιν τοῦ Ἀντιφώνου, ἐλθὼν ὁ Διάκονος καὶ στὰς ἐν τῷ συνήθει τόπῳ ἐκφωνεῖ τὴν μικρὰν Συναπτήν·"
ruLI.Rubric_013a.text = "Ὁ Ἱερεὺς ἀναγινώσκει τὴν εὐχὴν τοῦ Ἀντιφώνου·"
ruLI.Rubric_014a.text = "Ὁ Ἱερεὺς ἐκφώνως·"
ruLI.Rubric_015a.text = "Ὁ Διάκονος, προσκυνήσας καὶ ποιήσας σχῆμα, εἰσέρχεται διὰ τῆς νοτίου Πύλης εἰς τὸ ἅγιον Βῆμα καί, ποιήσας σχῆμα πρὸς τὸν Ἱερέα, ἵσταται εὐλαβῶς εἰς τὸ δεξιὸν μέρος τῆς ἁγίας Τραπέζης πλαγίως, μὴ ἀναβαίνων ἐπὶ τῆς κρηπῖδος."
ruLI.Rubric_016a.text = "Ψαλλομένου δὲ τοῦ Γʹ Ἀντιφώνου ἢ τοῦ Δόξα τῶν Μακαρισμῶν παρὰ τῶν Χορῶν, ὁ Ἱερεὺς καὶ ὁ Διάκονος στάντες ἔμπροσθεν τῆς ἁγίας Τραπέζης προσκυνοῦσι τρίς. Ὁ Ἱερεὺς εἶτα λαβὼν τὸ ἱερὸν Εὐαγγέλιον δίδωσι τῷ Διακόνῳ, ὅστις παραλαμβάνων αὐτὸ ἀσπάζεται τὴν χεῖρα τοῦ Ἱερέως καί, προπορευομένου λαμπαδούχου καὶ ἑξαπτερύγων, περιέρχεται κύκλῳ τὴν ἁγίαν Τράπεζαν, ἑπομένου τοῦ Ἱερέως καὶ ποιοῦσιν εἴσοδον (τὴν λεγομένην μικράν). Μὴ ὑπάρχοντος δὲ Διακόνου λαμβάνει τὸ ἱερὸν Εὐαγγέλιον ὁ Ἱερεὺς πρὸ προσώπου αὐτοῦ. Διασχίσαντες δὲ τὸ βόρειον κλίτος καὶ τὸ κεντρικὸν ἔρχονται εἰς τὸ μέσον τοῦ ναοῦ καὶ σταθέντες κλίνουσι τὰς κεφαλάς· καὶ τοῦ Διακόνου εἰπόντος·"
ruLI.Rubric_017a.text = "Ὁ Ἱερεὺς λέγει τὴν εὐχήν·"
ruLI.Rubric_018a.text = "Πληρωθείσης δὲ τῆς εὐχῆς ταύτης καὶ ἀμφοτέρων ἀνακυψάντων, ὁ Διάκονος, κρατῶν τὸ ὀράριον τῇ δεξιᾷ χειρὶ καὶ δεικνύων διʼ αὐτῆς πρὸς ἀνατολάς, λέγει πραείᾳ τῇ φωνῇ πρὸς τὸν Ἱερέα·"
ruLI.Rubric_019a.text = "Καὶ ὁ Ἱερεὺς εὐλογῶν σταυροειδῶς, διὰ τῆς δεξιᾶς πρὸς ἀνατολάς, λέγει ταπεινῇ τῇ φωνῇ·"
ruLI.Rubric_020a.text = "Εἶτα ὁ Διάκονος προσφέρει τῷ Ἱερεῖ τὸ ἱερὸν Εὐαγγέλιον, ὅστις ἀσπάζεται αὐτό, ὁ δὲ Διάκονος ἀσπάζεται τὴν δεξιὰν αὐτοῦ. Πληρωθέντος δὲ τοῦ Ἀντιφώνου ὁ Διάκονος ἱστάμενος ἔμπροσθεν τοῦ Ἱερέως καὶ ὑψῶν τὸ ἱερὸν Εὐαγγέλιον, ἴσον τῷ μετώπῳ αὐτοῦ, λέγει ἐκφώνως·"


ruLI.Rubric_021a.text = "Καὶ εἰσέρχονται εἰς τὸ ἅγιον Βῆμα διὰ τῆς Ὡραίας Πύλης· καὶ ὁ μὲν Διάκονος ἀποτίθησι τὸ ἱερὸν Εὐαγγέλιον ἐν τῇ ἁγίᾳ Τραπέζῃ· οἱ δὲ Χοροὶ ψάλλουσι τὸ Εἰσοδικόν· Δεῦτε προσκυνήσωμεν…, τὰ Ἀπολυτίκια τῆς ἡμέρας, τὸ τοῦ ἁγίου τοῦ ναοῦ καὶ ἐν τέλει τὸ Κοντάκιον τῆς ἐκκλησιαστικῆς περιόδου."
ruLI.Rubric_022a.text = "Πληρωθέντων δὲ τῶν Ἀπολυτικίων καὶ τοῦ Κοντακίου, ὁ Διάκονος, στραφεὶς πρὸς τὸν λαόν, ἐκφωνεῖ·"
ruLI.Rubric_023a.text = "Καὶ ἀπέρχεται εἰς τὸν συνήθη τόπον."
ruLI.Rubric_024a.text = "Ὁ δὲ Ἱερεύς, ἔμπροσθεν τῆς ἁγίας Τραπέζης ἱστάμενος, ἀναγινώσκει τὴν εὐχήν·"
ruLI.Rubric_024b.text = "Ἐκφώνως·"
ruLI.Rubric_025a.text = "Ὁ Διάκονος, ἐπιστραφεὶς καὶ πάλιν πρὸς τὸν λαὸν ἀπὸ τῆς Ὡραίας Πύλης, συμπληροῖ τὴν Ἐκφώνησιν τοῦ Ἱερέως λέγων ἐκφώνως·"
ruLI.Rubric_026a.text = "Εἶτα ἐπανέρχεται ὁ Διάκονος εἰς τὸν συνήθη τόπον ἐν τῷ ἁγίῳ Βήματι."
ruLI.Rubric_027a.text = "Οἱ Χοροὶ ψάλλουσι τό· Ἅγιος ὁ Θεὸς (ἐκ γʹ)· τὸ αὐτὸ λέγουσιν ἐναλλὰξ πραείᾳ τῇ φωνῇ, ὅ τε Ἱερεὺς καὶ ὁ Διάκονος, ποιοῦντες ὁμοῦ τρία προσκυνήματα ἔμπροσθεν τῆς ἁγίας Τραπέζης. Μετὰ δὲ τό· Δόξα, καὶ νῦν, τοῦ Τρισαγίου, ψαλλομένου ὑπὸ τῶν Χορῶν, ὁ Διάκονος ἐκφωνεῖ·"
ruLI.Rubric_028a.text = "Εἶτα ὁ Διάκονος λέγει πρὸς τὸν Ἱερέα·"
ruLI.Rubric_029a.text = "Καὶ ἀπέρχονται ἐν τῇ Καθέδρᾳ, προηγουμένου τοῦ Ἱερέως καὶ ἑπομένου τοῦ Διακόνου."
ruLI.Rubric_030a.text = "Ὁ δὲ Ἱερεὺς ἀπερχόμενος λέγει·"
ruLI.Rubric_031a.text = "Ὁ Διάκονος δεικνύων διὰ τῆς δεξιᾶς τὸ ἱερὸν Σύνθρονον, λέγει·"
ruLI.Rubric_032a.text = "Ὁ Ἱερεὺς ἀπέρχεται λέγων·"
ruLI.Rubric_033a.text = "Πληρωθέντος τοῦ Τρισαγίου παρὰ τῶν Χορῶν, ὁ Διάκονος, προσερχόμενος πρὸ τῆς Ὡραίας Πύλης, λέγει ἐκφώνως·"
ruLI.Rubric_034a.text = "Ὁ Ἀναγνώστης ἀπαγγέλλει τοὺς στίχους τοῦ Προκειμένου, μεθʼ ὃ ὁ Διάκονος ἐκφωνεῖ."
ruLI.Rubric_035a.text = "Ὁ Ἀναγνώστης ἀναγινώσκει τὴν ἐπιγραφὴν τῆς Ἀποστολικῆς περικοπῆς εἶτα ὁ Διάκονος ἐκφώνως·"
ruLI.Rubric_036a.text = "Τοῦ Ἀναγνώστου ἀπαγγέλλοντος ἐμμελῶς καὶ εὐκρινῶς τὴν περικοπὴν τοῦ Ἀποστολικοῦ ἀναγνώσματος, ὁ Διάκονος, λαβὼν τὸ θυμιατήριον, προσάγει αὐτὸ πρὸς εὐλογίαν τῷ Ἱερεῖ, λέγων· Εὐλόγησον, δέσποτα, τὸ θυμίαμα. Καί, τοῦ Ἱερέως εὐλογήσαντος αὐτό, θυμιᾷ, ὅσον τὸ δυνατὸν συντόμως, ἄνευ θορύβου τῶν κωδωνίσκων τοῦ θυμιατηρίου, τὴν ἁγίαν Τράπεζαν καὶ ἀπὸ τῆς Ὡραίας Πύλης τὰς Δεσποτικὰς εἰκόνας καὶ τὸν λαόν. Ὁ δὲ Ἱερεὺς ἀναγινώσκει πρὸ τῆς ἁγίας Τραπέζης τὴν εὐχὴν τοῦ Εὐαγγελίου·"
ruLI.Rubric_037a.text = "Εἶτα ὑποκλίνας τὴν κεφαλὴν τῷ Ἱερεῖ λέγει ὁ Διάκονος·"
ruLI.Rubric_038a.text = "Εὐλόγησον, δέσποτα, τὸν εὐαγγελιστὴν τοῦ ἁγίου ἐνδόξου ἀποστόλου καὶ εὐαγγελιστοῦ (δεῖνος)."
ruLI.Rubric_039a.text = "Ὁ δὲ Ἱερεὺς σφραγίζων αὐτὸν λέγει ἠρέμα·"
ruLI.Rubric_040a.text = "Ὁ Θεὸς διὰ πρεσβειῶν τοῦ ἁγίου, ἐνδόξου, ἀποστόλου καὶ εὐαγγελιστοῦ (δεῖνος) δῴη σοι ῥῆμα τῷ εὐαγγελιζομένῳ δυνάμει πολλῇ, εἰς ἐκπλήρωσιν τοῦ Εὐαγγελίου τοῦ ἀγαπητοῦ αὐτοῦ Υἱοῦ, Κυρίου δὲ ἡμῶν Ἰησοῦ Χριστοῦ."
ruLI.Rubric_041a.text = "Καὶ ἐπιδίδωσι τῷ Διακόνῳ τὸ ἱερὸν Εὐαγγέλιον λέγοντι ἠρέμα τό· Ἀμήν, ἀμήν, ἀμήν. Γένοιτό μοι κατὰ τὸ ῥῆμά σου."
ruLI.Rubric_042a.text = "Καὶ ἀσπασάμενος τὴν χεῖρα τοῦ Ἱερέως ἀπέρχεται εἰς τὸν ἱερὸν Ἄμβωνα."
ruLI.Rubric_043a.text = "Πληρωθείσης τῆς ἀναγνώσεως τῆς Ἀποστολικῆς περικοπῆς, ὁ Ἱερεὺς εὐλογεῖ τὸν Ἀναγνώστην, ἐπιλέγων ἠρέμα·"
ruLI.Rubric_044a.text = "Ὁ ἀριστερὸς Χορὸς ψάλλει τρὶς τό· Ἀλληλούϊα."
ruLI.Rubric_045a.text = "Εἶτα ὁ Ἱερεὺς ἢ ὁ βʹ Διάκονος, εἰ ἔστι, προσερχόμενος πρὸ τῆς Ὡραίας Πύλης καὶ προσβλέπων πρὸς τὸν λαόν, ἐκφωνεῖ·"
ruLI.Rubric_046a.text = "Καὶ ὁ Ἱερεὺς εὐλογῶν τὸν λαὸν διὰ τῆς χειρὸς λέγει·"
ruLI.Rubric_047a.text = "Ὁ δὲ Διάκονος ἀπὸ τοῦ Ἄμβωνος·"
ruLI.Rubric_048a.text = "Ὁ Ἱερεὺς ἢ ὁ βʹ Διάκονος·"
ruLI.Rubric_049a.text = "Καὶ ἀναγινώσκει ὁ Διάκονος τὴν τεταγμένην Εὐαγγελικὴν περικοπὴν εὐκρινῶς καὶ σεμνοπρεπῶς λαμπρᾷ καὶ καθαρᾷ τῇ φωνῇ."
ruLI.Rubric_050a.text = "Μετὰ δὲ τὴν ἀνάγνωσιν τοῦ ἱεροῦ Εὐαγγελίου ὁ Ἱερεὺς εὐλογῶν τὸν Διάκονον λέγει· Εἰρήνη σοι."
ruLI.Rubric_051a.text = "Καὶ παραλαβὼν ἀπὸ τῶν χειρῶν τοῦ Διακόνου τὸ ἱερὸν Εὐαγγέλιον, ἐναποτίθησιν αὐτὸ ἐπὶ τῆς ἁγίας Τραπέζης."
ruLI.Rubric_052a.text = "Ὁ δὲ Χορὸς ψάλλει ἀργῶς· Δόξα σοι, Κύριε, δόξα σοι."
ruLI.Rubric_053a.text = "Εἶτα ὁ Διάκονος ἐξέρχεται ἐκ τῆς βορείου Πύλης, ἵσταται ἐν τῷ συνήθει πρὸ τῆς Ὡραίας Πύλης τόπῳ, καὶ λέγει ἐκφώνως τὴν Ἐκτενῆ, τῶν Χορῶν ψαλλόντων ἐναλλὰξ μεθʼ ἑκάστην αἴτησιν τό· Κύριε, ἐλέησον."
ruLI.Rubric_053b.text = "Ὁ Ἱερεὺς ἀναγινώσκει τὴν εὐχὴν τῆς ἐκτενοῦς ἱκεσίας·"
ruLI.Rubric_054a.text = "Ὁ Ἱερεὺς ἐκφώνως·"
ruLI.Rubric_055a.text = "Ὁ Διάκονος λέγει τὰς ὑπὲρ τῶν κατηχουμένων δεήσεις, τῶν Χορῶν ἐναλλὰξ ψαλλόντων τό· Κύριε, ἐλέησον."
ruLI.Rubric_056a.text = "Ὁ Ἱερεὺς ἀναγινώσκει, πρὸ τοῦ ἁπλωθῆναι τὸ εἰλητόν, τὴν εὐχήν·"
ruLI.Rubric_057a.text = "Ὁ Ἱερεὺς ἐκφώνως·"
ruLI.Rubric_058a.text = "Εἶτα ὁ μὲν Ἱερεύς, λαβὼν τὸ ἱερὸν Εὐαγγέλιον καὶ ποιήσας μετʼ αὐτοῦ τύπον σταυροῦ ἐπὶ τοῦ εἰλητοῦ, ἀποθέτει τοῦτο εἰς τὸ ἄνω μέρος τῆς ἁγίας Τραπέζης καὶ ἐξαπλοῖ τὸ εἰλητόν, ὁ δὲ Διάκονος λέγει ἐκφώνως·"
ruLI.Rubric_059a.text = "Ὁ Ἱερεὺς ἀναγινώσκει τὴν εὐχήν·"
ruLI.Rubric_060a.text = "Ὁ Ἱερεὺς ἐκφώνως·"
ruLI.Rubric_061a.text = "Ὁ Διάκονος ἐξακολουθεῖ·"
ruLI.Rubric_062a.text = "Εἶτα ὁ Διάκονος, εἰσέρχεται διὰ τῆς νοτίου Πύλης εἰς τὸ ἅγιον Βῆμα καὶ καταλαμβάνει τὸν συνήθη τόπον."
ruLI.Rubric_063a.text = "Ψαλλομένου δὲ ὑπὸ τοῦ Χοροῦ ἀργῶς καὶ μετὰ μέλους τοῦ Χερουβικοῦ ὕμνου, ὁ Ἱερεύς, ἀναγινώσκει καθʼ ἑαυτὸν μετʼ εὐλαβείας ἄκρας τὴν εὐχήν·"
ruLI.Rubric_064a.text = "Μετὰ τὴν συμπλήρωσιν τῆς ἀνωτέρω εὐχῆς, ὅ τε Ἱερεὺς καὶ ὁ Διάκονος λέγουσι χῦμα τὸν Χερουβικὸν ὕμνον ἐκ τρίτου, προσκυνοῦντες."
ruLI.Rubric_065a.text = "Μετὰ ταῦτα ὁ Ἱερεὺς θυμιᾷ ἀσκεπὴς τὴν ἁγίαν Τράπεζαν καὶ τὴν Πρόθεσιν καί, μικρὸν προελθὼν τῆς Ὡραίας Πύλης, θυμιᾷ τὸν ἀρχιερατικὸν Θρόνον, τὰς Δεσποτικὰς εἰκόνας καὶ τὸν λαόν. Ἐν τῷ θυμιᾶν δὲ λέγει καθʼ ἑαυτόν, εἰ μέν ἐστι Κυριακή, τό· Ἀνάστασιν Χριστοῦ θεασάμενοι… καὶ τὸν Νʹ Ψαλμὸν μέχρι τοῦ· ὁ Θεὸς οὐκ ἐξουδενώσει, εἰ δὲ οὐκ ἔστι, λέγει τό· Δεῦτε προσκυνήσωμεν… (ἐκ γʹ) καὶ εἶτα τὸν Νʹ Ψαλμόν."
ruLI.Rubric_066a.text = "Εἶτα προσέρχεται μετὰ τοῦ Διακόνου, πρὸ τῆς ἁγίας Τραπέζης, ποιοῦσιν ὁμοῦ προσκυνήματα τρία καὶ ἀσπάζονται τὸ εἰλητὸν καὶ τὴν ἁγίαν Τράπεζαν· αὖθις δὲ (ἐκ γʹ) προσκυνήσαντες αἰτοῦσι συγχώρησιν παρʼ ἀλλήλων καὶ προχωροῦσι πρὸς τὴν Ὡραίαν Πύλην, στρέφονται πρὸς τὸν λαόν, αἰτοῦντες συγχώρησιν παρʼ αὐτοῦ, ὑποκλίναντες δὲ τὰς κεφαλὰς αὐτῶν ἀπέρχονται ἐν τῇ Προθέσει."
ruLI.Rubric_067a.text = "Εἶτα ὁ Διάκονος, στραφεὶς πρὸς τὸν Ἱερέα, λέγει·"
ruLI.Rubric_068a.text = "Ἔπαρον, δέσποτα."
ruLI.Rubric_069a.text = "Καὶ ὁ Ἱερεύς, ἄρας μετʼ εὐλαβείας τὸν ἀέρα, ἐπιτίθησιν ἐπὶ τῶν ὤμων τοῦ Διακόνου λέγων·"
ruLI.Rubric_070a.text = "Ἐν εἰρήνῃ ἐπάρατε τὰς χεῖρας ὑμῶν εἰς τὰ ἅγια καὶ εὐλογεῖτε τὸν Κύριον."
ruLI.Rubric_071a.text = "Εἶτα ὁ Ἱερεὺς λαβὼν τὸν ἅγιον δίσκον, ἐπιβάλλει μετὰ πάσης προσοχῆς καὶ εὐλαβείας ἐπὶ τὴν κεφαλὴν τοῦ Διακόνου, ἀσπαζομένου τὴν δεξιὰν αὐτοῦ, καὶ ὁ Διάκονος κρατεῖ τοῦτον διʼ ἀμφοτέρων τῶν χειρῶν ἐπὶ τῆς κεφαλῆς αὐτοῦ. Αὐτὸς δὲ ὁ Ἱερεὺς λαμβάνει ἀνὰ χεῖρας τὸ ἅγιον ποτήριον."
ruLI.Rubric_072a.text = "Μὴ ὄντος δὲ Διακόνου ὁ Ἱερεὺς ἐπιτίθησι τὸν ἀέρα ἐπὶ τῶν ὤμων ἑαυτοῦ καὶ λαμβάνει τὸ μὲν ἅγιον ποτήριον ἐν τῇ δεξιᾷ χειρί, τὸν δὲ ἅγιον δίσκον ἐν τῇ ἀριστερᾷ."
ruLI.Rubric_073a.text = "Ὡς δὲ ὁ Χορὸς εἴπῃ τό· Ὡς τὸν βασιλέα, τότε, σιγήσαντος τοῦ Χοροῦ, ὁ Διάκονος καὶ ὁ Ἱερεὺς ἐξέρχονται ἐκ τῆς βορείου Πύλης τοῦ ἁγίου Βήματος, προηγουμένων λαμπάδων, ἑξαπτερύγων καὶ θυμιατηρίου, διέρχονται τὸ βόρειον κλίτος καὶ τὸ μέσον τοῦ ναοῦ καὶ γίνεται ἡ εἴσοδος τῶν τιμίων Δώρων (ἡ λεγομένη μεγάλη εἴσοδος)."
ruLI.Rubric_074a.text = "Πορευόμενοι δὲ ἐκφωνοῦσιν ἀλληλοδιαδόχως·"
ruLI.Rubric_075a.text = "Ὁ ἀριστερὸς Χορός· Ἀμήν. Καὶ συμπληροῖ τὸν Χερουβικὸν ὕμνον."
ruLI.Rubric_076a.text = "Εἰσελθὼν δὲ ὁ Διάκονος εἰς τὸ ἅγιον Βῆμα, ἵσταται ἐνώπιον τῆς ἁγίας Τραπέζης ἐν τοῖς δεξιοῖς καὶ λέγει πρὸς τὸν Ἱερέα εἰσερχόμενον·"
ruLI.Rubric_077a.text = "Τῆς ἱερωσύνης σου μνησθείη Κύριος ὁ Θεὸς ἐν τῇ βασιλείᾳ αὐτοῦ πάντοτε, νῦν καὶ ἀεὶ καὶ εἰς τοὺς αἰῶνας τῶν αἰώνων."
ruLI.Rubric_078a.text = "Καὶ ὁ Ἱερεὺς πρὸς αὐτόν·"
ruLI.Rubric_079a.text = "Τῆς διακονίας σου μνησθείη Κύριος ὁ Θεὸς ἐν τῇ βασιλείᾳ αὐτοῦ πάντοτε, νῦν καὶ ἀεὶ καὶ εἰς τοὺς αἰῶνας τῶν αἰώνων."
ruLI.Rubric_080a.text = "Καὶ ἀποτίθησι μὲν ὁ Ἱερεὺς τὸ ἅγιον ποτήριον ἐν τῇ ἁγίᾳ Τραπέζῃ· λαβὼν δὲ καὶ τὸν ἅγιον δίσκον ἀπὸ τῆς κεφαλῆς τοῦ Διακόνου, ἀποτίθησι καὶ αὐτὸν ἐξ ἀριστερῶν τοῦ ἁγίου ποτηρίου."
ruLI.Rubric_081a.text = "Εἶτα ὁ Ἱερεὺς αἴρει τὰ καλύμματα ἀπό τε τοῦ ἁγίου δίσκου καὶ τοῦ ποτηρίου καὶ διπλώσας ἀποτίθησιν αὐτά· καὶ λαβὼν τὸν ἀέρα ἀπὸ τῶν ὤμων τοῦ Διακόνου καὶ θυμιάσας αὐτόν, σκεπάζει τὰ ἅγια. Μετὰ τοῦτο, λαβὼν τὸ θυμιατήριον καὶ τοῦ Διακόνου εἰπόντος ἠρέμα·"
ruLI.Rubric_082a.text = "Ἀγάθυνον, δέσποτα."
ruLI.Rubric_083a.text = "Ὁ Ἱερεὺς θυμιῶν τρὶς τὰ ἅγια λέγει ἅπαξ·"
ruLI.Rubric_084a.text = "Ἀγάθυνον, Κύριε, ἐν τῇ εὐδοκίᾳ σου τὴν Σιών, καὶ οἰκοδομηθήτω τὰ τείχη Ἱερουσαλήμ. Τότε εὐδοκήσεις θυσίαν δικαιοσύνης, ἀναφορὰν καὶ ὁλοκαυτώματα. Τότε ἀνοίσουσιν ἐπὶ τὸ θυσιαστήριόν σου μόσχους."
ruLI.Rubric_085a.text = "Καὶ ἀποδοὺς τὸ θυμιατήριον, ὑποκλίνας τε μικρὸν τὴν κεφαλήν, λέγει πρὸς τὸν Διάκονον·"
ruLI.Rubric_086a.text = "Μνήσθητί μου, ἀδελφὲ καὶ συλλειτουργέ."
ruLI.Rubric_087a.text = "Καὶ ὁ Διάκονος πρὸς αὐτόν·"
ruLI.Rubric_088a.text = "Μνησθείη σου Κύριος ὁ Θεὸς ἐν τῇ βασιλείᾳ αὐτοῦ πάντοτε, νῦν καὶ ἀεὶ καὶ εἰς τοὺς αἰῶνας τῶν αἰώνων."
ruLI.Rubric_089a.text = "Εἶτα ὁ Διάκονος, ὑποκλίνας καὶ αὐτὸς τὴν κεφαλήν, λέγει πρὸς τὸν Ἱερέα·"
ruLI.Rubric_090a.text = "Εὖξαι ὑπὲρ ἐμοῦ, δέσποτα ἅγιε."
ruLI.Rubric_091a.text = "Ὁ Ἱερεὺς εὐλογῶν σταυροειδῶς τὸν Διάκονον·"
ruLI.Rubric_092a.text = "Πνεῦμα ἅγιον ἐπελεύσεται ἐπὶ σέ, καὶ δύναμις Ὑψίστου ἐπισκιάσει σοι."
ruLI.Rubric_093a.text = "Καὶ ὁ Διάκονος·"
ruLI.Rubric_094a.text = "Αὐτὸ τὸ Πνεῦμα συλλειτουργήσει ἡμῖν πάσας τὰς ἡμέρας τῆς ζωῆς ἡμῶν."
ruLI.Rubric_095a.text = "Καὶ πάλιν ὁ Διάκονος·"
ruLI.Rubric_096a.text = "Μνήσθητί μου, δέσποτα ἅγιε."
ruLI.Rubric_097a.text = "Καὶ ὁ Ἱερεύς·"
ruLI.Rubric_098a.text = "Μνησθείη σου Κύριος ὁ Θεὸς ἐν τῇ βασιλείᾳ αὐτοῦ πάντοτε, νῦν καὶ ἀεὶ καὶ εἰς τοὺς αἰῶνας τῶν αἰώνων."
ruLI.Rubric_099a.text = "Εἶτα ὁ Διάκονος, εἰπὼν τό· Ἀμὴν καὶ τὴν δεξιὰν τοῦ Ἱερέως ἀσπασάμενος, ἐξελθὼν διὰ τῆς βορείου Πύλης, ἵσταται ἐν τῷ συνήθει τόπῳ, ὡς προεγράφη, καὶ λέγει τὰ Πληρωτικά."

ruLI.Rubric_100a.text = "Ὁ Ἱερεὺς ἀναγινώσκει τὴν εὐχὴν μετὰ τὸ ἀποτεθῆναι τὰ ἅγια ἐν τῇ ἁγίᾳ Τραπέζῃ·"
ruLI.Rubric_101a.text = "Ὁ Ἱερεὺς ἐκφώνως·"
ruLI.Rubric_102a.text = "Ὁ Ἱερεύς, προχωρῶν πρὸς τὴν Ὡραίαν Πύλην, εὐλογεῖ τὸν λαὸν διὰ τῆς δεξιᾶς χειρὸς λέγων·"
ruLI.Rubric_103a.text = "Ὁ Ἱερεύς, ἔνδον ἱστάμενος καὶ προσκυνήσας τρίς, ἀσπάζεται τὰ κεκαλυμμένα ἅγια, λέγων καθʼ ἑαυτόν·"
ruLI.Rubric_104a.text = "Ἀγαπήσω σε, Κύριε, ἡ ἰσχύς μου. Κύριος στερέωμά μου καὶ καταφυγή μου καὶ ῥύστης μου."
ruLI.Rubric_105a.text = "Ὁ Προεστὼς ἔξωθεν τοῦ ἁγίου Βήματος ἢ ὁ Ἀναγνώστης, τρανῶς καὶ εὐκρινῶς, ἀπαγγέλλει τὸ Σύμβολον τῆς Πίστεως· Πιστεύω εἰς ἕνα Θεόν…"
ruLI.Rubric_106a.text = "Ὁ Ἱερεύς, ἄρας καὶ κατὰ μικρὸν ὑψῶν τὸν ἀέρα, ἀνασείει αὐτὸν ἀνοικτὸν ἠρέμα ἐπάνω τῶν τιμίων Δώρων. Ὅτε δὲ ἡ ἀπαγγελία τοῦ Συμβόλου φθάσῃ εἰς τὸ ἄρθρον· Καὶ ἀνελθόντα εἰς τοὺς οὐρανούς…, ποιήσας τύπον σταυροῦ διὰ τοῦ ἀέρος ὑπεράνω τῶν τιμίων Δώρων, αἴρει αὐτόν, διπλώσας δὲ καὶ ἀσπασάμενος ἀποτίθησι μετὰ τῶν ἄλλων καλυμμάτων."
ruLI.Rubric_107a.text = "Πληρωθείσης τῆς ἀπαγγελίας τοῦ Συμβόλου, ὁ Διάκονος ἐκφωνεῖ·"
ruLI.Rubric_108a.text = "Ὁ Ἱερεὺς στραφεὶς πρὸς τὸν λαὸν εὐλογεῖ αὐτὸν διὰ τῆς δεξιᾶς χειρὸς λέγων·"
ruLI.Rubric_109a.text = "Εἶτα ὑψῶν ἀμφοτέρας τὰς χεῖρας λέγει·"
ruLI.Rubric_110a.text = "Καὶ στραφεὶς πρὸς ἀνατολάς, ἐκφωνεῖ·"
ruLI.Rubric_111a.text = "Καὶ ἐπιστρέφει πρὸ τῆς ἁγίας Τραπέζης."
ruLI.Rubric_112a.text = "Εἶτα ὁ Διάκονος εἰσέρχεται εἰς τὸ ἅγιον Βῆμα διὰ τῆς νοτίου Πύλης καὶ ἵσταται πλαγίως ἐκ δεξιῶν τοῦ πρὸ τῆς ἁγίας Τραπέζης ἱσταμένου Ἱερέως."
ruLI.Rubric_113a.text = "Καὶ ὁ Ἱερεὺς κλινόμενος ἀπάρχεται τῆς ἁγίας ἀναφορᾶς."
ruLI.Rubric_114a.text = "Ὁ Ἱερεὺς ἐκφώνως·"
ruLI.Rubric_115a.text = "Τούτου λεγομένου, λαβὼν ὁ Διάκονος τὸν ἀστερίσκον ἐκ τοῦ ἁγίου δίσκου, ποιεῖ τύπον σταυροῦ ἐπάνω αὐτοῦ καί, ἀποσπογγίσας ἐν τῷ εἰλητῷ καὶ ἀσπασάμενος αὐτόν, ἀποτίθησιν εἰς τὸ ἄνω μέρος τοῦ εἰλητοῦ."
ruLI.Rubric_116a.text = "Ὁ δὲ Ἱερεὺς ἐπεύχεται·"
ruLI.Rubric_117a.text = "Ὁ Ἱερεὺς ἐκφώνως·"
ruLI.Rubric_118a.text = "Καὶ πάλιν ἐπεύχεται ὁ Ἱερεύς·"
ruLI.Rubric_119a.text = "Ὁ Ἱερεὺς ἐκφώνως·"
ruLI.Rubric_120a.text = "Ὁ Ἱερεὺς κλινόμενος ἐπεύχεται·"
ruLI.Rubric_121a.text = "Ἐκφώνως·"
ruLI.Rubric_122a.text = "Τούτου λεγομένου ὁ Ἱερεὺς ὑψοῖ τὰ ἅγια, διασταυρῶν τὰς χεῖρας καὶ λαμβάνων διὰ τῆς δεξιᾶς χειρὸς τὸν ἅγιον δίσκον καὶ διὰ τῆς ἀριστερᾶς τὸ ἅγιον ποτήριον."
ruLI.Rubric_123a.text = "Ὁ δὲ Ἱερεὺς κλίνας τὴν κεφαλὴν ἐπεύχεται·"
ruLI.Rubric_124a.text = "Εἶτα τὴν κεφαλὴν ὑποκλίνας ὁ Διάκονος καὶ δεικνύων διὰ τοῦ ὀραρίου τὸν ἅγιον δίσκον λέγει ἠρέμα·"
ruLI.Rubric_125a.text = "Καὶ ὁ Ἱερεὺς ἀνιστάμενος σφραγίζει τὸν ἅγιον Ἄρτον λέγων·"
ruLI.Rubric_126a.text = "Καὶ αὖθις ὁ αὐτὸς δεικνύων διὰ τοῦ ὀραρίου τὸ ἅγιον ποτήριον·"
ruLI.Rubric_127a.text = "Καὶ ὁ Ἱερεὺς εὐλογῶν λέγει·"
ruLI.Rubric_128a.text = "Καὶ αὖθις ὁ Διάκονος δεικνύων μετὰ τοῦ ὀραρίου ἀμφότερα τὰ ἅγια λέγει·"
ruLI.Rubric_129a.text = "Ὁ δὲ Ἱερεὺς εὐλογῶν ἀμφότερα τὰ ἅγια λέγει·"
ruLI.Rubric_130a.text = "Ὁ δὲ Ἱερεὺς ἐπεύχεται·"
ruLI.Rubric_131a.text = "Εἶτα θυμιῶν τὴν ἁγίαν Τράπεζαν κατέμπροσθεν λέγει ἐκφώνως·"
ruLI.Rubric_132a.text = "Καὶ ἐπιδίδωσι τὸ θυμιατήριον τῷ Διακόνῳ, ὅστις θυμιᾷ πρῶτον τὸν Ἱερέα, εἶτα δὲ ἔρχεται εἰς τὸ ὄπισθεν τῆς ἁγίας Τραπέζης καὶ μνημονεύει καθʼ ἑαυτὸν ὧν βούλεται τεθνεώτων."
ruLI.Rubric_133a.text = "Ὁ Χορὸς τό· Ἄξιόν ἐστιν ὡς ἀληθῶς… ἢ τὸν Εἱρμὸν τῆς θʹ ᾨδῆς τῆς τυχούσης Δεσποτικῆς ἢ Θεομητορικῆς ἑορτῆς."
ruLI.Rubric_134a.text = "Τούτου δὲ ψαλλομένου, ὁ Ἱερεὺς ἐπεύχεται·"
ruLI.Rubric_135a.text = "Ἐκφώνως·"
ruLI.Rubric_136a.text = "Καὶ ὁ Διάκονος πρὸς τῇ θύρᾳ στὰς λέγει·"
ruLI.Rubric_137a.text = "Ὁ Χορός· Καὶ πάντων καὶ πασῶν."
ruLI.Rubric_138a.text = "Ὁ δὲ Ἱερεὺς ἐπεύχεται·"
ruLI.Rubric_139a.text = "Ἐκφώνως·"
ruLI.Rubric_140a.text = "Καὶ ὁ Ἱερεύς, στραφεὶς πρὸς τὸν λαόν, εὐλογεῖ αὐτὸν διὰ τῆς δεξιᾶς χειρὸς λέγων ἐκφώνως·"
ruLI.Rubric_141a.text = "Ὁ δὲ Διάκονος, ἐξελθὼν καὶ στὰς ἐν τῷ συνήθει τόπῳ πρὸ τῆς Ὡραίας Πύλης, ἐκφωνεῖ τὰ κάτωθι, τῶν Χορῶν ἐναλλὰξ ψαλλόντων μεθʼ ἑκάστην δέησιν τό· Κύριε, ἐλέησον ἅπαξ."
ruLI.Rubric_142a.text = "Ὁ Ἱερεὺς ἐπεύχεται·"
ruLI.Rubric_143a.text = "Ὁ Ἱερεὺς ἐκφώνως·"
ruLI.Rubric_144a.text = "Ὁ Προεστὼς ἢ ὁ Ἀναγνώστης, τρανῶς καὶ εὐκρινῶς, ἀπαγγέλλει τό· Πάτερ ἡμῶν…, οὗ λεγομένου ὁ Διάκονος ζώννυται τὸ ὀράριον αὐτοῦ σταυροειδῶς."
ruLI.Rubric_145a.text = "Ὁ Ἱερεὺς ἐκφώνως·"
ruLI.Rubric_146a.text = "Ὁ Ἱερεύς, στραφεὶς πρὸς τὸν λαὸν καὶ εὐλογῶν, λέγει·"
ruLI.Rubric_147a.text = "Ὁ Ἱερεὺς ἐπεύχεται·"
ruLI.Rubric_148a.text = "Ἐκφώνως·"
ruLI.Rubric_149a.text = "Ὁ Ἱερεὺς ἐπεύχεται·"
ruLI.Rubric_150a.text = "Εἶτα προσκυνεῖ ὁ Ἱερεύς, ὁμοίως καὶ ὁ Διάκονος ἐν ᾧ εἰσι τόπῳ, λέγοντες καθʼ ἑαυτοὺς τρίς· Ὁ Θεός, ἱλάσθητί μοι τῷ ἁμαρτωλῷ καὶ ἐλέησόν με."
ruLI.Rubric_151a.text = "Ὅταν δὲ ἴδῃ τὸν Ἱερέα ἐκτείνοντα τὰς χεῖρας καὶ ἁπτόμενον τοῦ ἁγίου Ἄρτου πρὸς τὸ ποιῆσαι τὴν ὕψωσιν, ἐκφωνεῖ·"
ruLI.Rubric_152a.text = "Ὁ Ἱερεύς, ἁψάμενος μικρὸν τοῦ ἁγίου Ἄρτου ἄκροις δακτύλοις ἀμφοτέρων τῶν χειρῶν, ὑψοῖ αὐτόν, ποιῶν σταυροῦ τύπον ἄνωθεν τοῦ ἁγίου δίσκου, καὶ ἐκφωνεῖ·"
ruLI.Rubric_153a.text = "καὶ εἶτα τὸ Κοινωνικόν."
ruLI.Rubric_154a.text = "Μετὰ τὸ ἐκφωνῆσαι τό· Πρόσχωμεν, ὁ Διάκονος εἰσέρχεται εἰς τὸ ἅγιον Βῆμα διὰ τῆς νοτίου Πύλης καί, στὰς ἐκ δεξιῶν τοῦ Ἱερέως κρατοῦντος τὸν ἅγιον Ἄρτον, λέγει πρὸς αὐτόν."
ruLI.Rubric_155a.text = "Μέλισον, δέσποτα, τὸν ἅγιον Ἄρτον."
ruLI.Rubric_156a.text = "Ὁ δὲ Ἱερεύς, μελίσας αὐτὸν εἰς τέσσαρας μερίδας μετὰ προσοχῆς καὶ εὐλαβείας, λέγει·"
ruLI.Rubric_157a.text = "Μελίζεται καὶ διαμερίζεται ὁ ἀμνὸς τοῦ Θεοῦ, ὁ μελιζόμενος καὶ μὴ διαιρούμενος, ὁ πάντοτε ἐσθιόμενος καὶ μηδέποτε δαπανώμενος, ἀλλὰ τοὺς μετέχοντας ἁγιάζων."
ruLI.Rubric_158a.text = "Καὶ τίθησιν αὐτὰς ἐν τῷ ἁγίῳ δίσκῳ σταυροειδῶς, οὕτως·"
ruLI.Rubric_159a.text = "[graphic of Ιϲ / ΝΙ ΚΑ / Χϲ]"
ruLI.Rubric_160a.text = "Καὶ ὁ Διάκονος δεικνύων διὰ τοῦ ἐν δεξιᾷ χειρὶ ὀραρίου τὸ ἅγιον ποτήριον λέγει·"
ruLI.Rubric_161a.text = "Πλήρωσον, δέσποτα, τὸ ἅγιον ποτήριον."
ruLI.Rubric_162a.text = "Ὁ δὲ Ἱερεὺς λαβὼν τὴν ἄνω κειμένην μερίδα, τὴν ἔχουσαν τοὺς χαρακτῆρας ΙC, ποιεῖ σὺν αὐτῇ σταυρὸν ἐπάνω τοῦ ἁγίου ποτηρίου λέγων·"
ruLI.Rubric_163a.text = "Πλήρωμα Πνεύματος ἁγίου."
ruLI.Rubric_164a.text = "Καὶ οὕτως ἐμβάλλει αὐτὴν εἰς τὸ ἅγιον ποτήριον."
ruLI.Rubric_165a.text = "Ὁ Διάκονος· Ἀμήν. Καὶ λαβὼν τὸ ζέον λέγει πρὸς τὸν Ἱερέα."
ruLI.Rubric_166a.text = "Εὐλόγησον, δέσποτα, τὸ ζέον."
ruLI.Rubric_167a.text = "Ὁ δὲ Ἱερεὺς εὐλογεῖ λέγων·"
ruLI.Rubric_168a.text = "Εὐλογημένη ἡ ζέσις τῶν ἁγίων σου πάντοτε, νῦν καὶ ἀεὶ καὶ εἰς τοὺς αἰῶνας τῶν αἰώνων. Ἀμήν."
ruLI.Rubric_169a.text = "Καὶ ὁ Διάκονος ἐγχέει τοῦ ζέοντος τὸ ἀρκοῦν σταυροειδῶς ἔνδον τοῦ ἁγίου ποτηρίου, λέγοντος τοῦ Ἱερέως·"
ruLI.Rubric_170a.text = "Ζέσις Πνεύματος ἁγίου."
ruLI.Rubric_171a.text = "Ὁ Διάκονος· Ἀμήν."
ruLI.Rubric_172a.text = "Εἶτα ὁ Ἱερεύς, προσκυνήσας τρίς, ὑποκλίνεται πρὸς τοὺς δεξιόθεν καὶ ἀριστερόθεν τυχὸν ἱσταμένους Κληρικοὺς καὶ τὸν Διάκονον καί, αἰτήσας συγχώρησιν παρʼ αὐτῶν, προσέρχεται καὶ κύπτει εὐλαβῶς πρὸ τοῦ ἁγίου δίσκου λέγων καθʼ ἑαυτόν·"
ruLI.Rubric_173a.text = "Ἰδοὺ προσέρχομαι Χριστῷ τῷ ἀθανάτῳ βασιλεῖ καὶ Θεῷ ἡμῶν."
ruLI.Rubric_174a.text = "Καὶ λαμβάνει τὴν κάτω κειμένην μερίδα τοῦ ἁγίου Ἄρτου ἐκ τοῦ τμήματος τοῦ φέροντος τοὺς χαρακτῆρας Χϲ καί, διελὼν αὐτὴν εἰς δύο μέρη, κρατεῖ ἐντὸς τῆς παλάμης τῆς δεξιᾶς χειρὸς τὸ ἓν μέρος λέγων·"
ruLI.Rubric_175a.text = "Μεταδίδοταί μοι (δεῖνι) τῷ ἀναξίῳ πρεσβυτέρῳ τὸ τίμιον καὶ πανάγιον Σῶμα τοῦ Κυρίου καὶ Θεοῦ καὶ σωτῆρος ἡμῶν Ἰησοῦ Χριστοῦ, εἰς ἄφεσίν μου ἁμαρτιῶν καὶ εἰς ζωὴν αἰώνιον."
ruLI.Rubric_176a.text = "Καὶ οὕτω μεταλαμβάνει τοῦ ἐν χερσὶ μετὰ φόβου καὶ πάσης ἀσφαλείας· καί, ἀποσπογγίσας τὴν δεξιὰν παλάμην διὰ τῆς μούσης ἐπὶ τοῦ ἁγίου δισκαρίου, λέγει ἡσύχως·"
ruLI.Rubric_177a.text = "Διάκονε, πρόσελθε."
ruLI.Rubric_178a.text = "Καὶ ὁ Διάκονος, προσκυνήσας εὐλαβῶς καὶ συγχώρησιν αἰτησάμενος παρὰ τοῦ Ἱερέως, προσέρχεται καὶ ἁπλοῖ τὰς χεῖρας, ἔχων τὴν δεξιὰν ἐπὶ τῆς ἀριστερᾶς παλάμης, καὶ λέγει καθʼ ἑαυτόν·"
ruLI.Rubric_179a.text = "Ἰδοὺ προσέρχομαι Χριστῷ τῷ ἀθανάτῳ βασιλεῖ καὶ Θεῷ ἡμῶν. Μετάδος μοι, δέσποτα, (δεῖνι) τῷ ἀναξίῳ διακόνῳ, τὸ τίμιον καὶ πανάγιον Σῶμα τοῦ Κυρίου καὶ Θεοῦ καὶ σωτῆρος ἡμῶν Ἰησοῦ Χριστοῦ, εἰς ἄφεσίν μου ἁμαρτιῶν καὶ εἰς ζωὴν αἰώνιον."
ruLI.Rubric_180a.text = "Καί, προσελθόντος τοῦ Διακόνου ἐκ δεξιῶν αὐτοῦ, μεταδίδωσιν αὐτῷ ἐν τῇ παλάμῃ τὸ ἕτερον μέρος τῆς μερίδος τοῦ ἁγίου Ἄρτου λέγων·"
ruLI.Rubric_181a.text = "Μεταδίδοταί σοι (δεῖνι) τῷ εὐλαβεστάτῳ διακόνῳ, τὸ τίμιον καὶ πανάγιον Σῶμα τοῦ Κυρίου καὶ Θεοῦ καὶ σωτῆρος ἡμῶν Ἰησοῦ Χριστοῦ, εἰς ἄφεσίν σου ἁμαρτιῶν καὶ εἰς ζωὴν αἰώνιον."
ruLI.Rubric_182a.text = "Ὁ δὲ Διάκονος, ἀσπασάμενος τὴν μεταδιδοῦσαν αὐτῷ χεῖρα, ἀπέρχεται ὄπισθεν τῆς ἁγίας Τραπέζης καὶ μεταλαμβάνει τοῦ ἐν τῇ παλάμῃ αὐτοῦ ἁγίου Ἄρτου, ὡς ὁ Ἱερεύς."
ruLI.Rubric_183a.text = "Εἶτα, λαβὼν ὁ Ἱερεὺς διὰ τῆς ἀριστερᾶς χειρὸς τὸ ἄκρον τοῦ μάκτρου, θέτει τοῦτο κάτωθεν τῶν χειλέων αὐτοῦ καὶ διὰ τῆς δεξιᾶς χειρὸς κρατεῖ τὸ ἅγιον ποτήριον καὶ λέγει·"
ruLI.Rubric_184a.text = "Ἔτι μεταδίδοταί μοι (δεῖνι) τῷ ἀναξίῳ πρεσβυτέρῳ τὸ τίμιον καὶ πανάγιον Αἷμα τοῦ Κυρίου καὶ Θεοῦ καὶ σωτῆρος ἡμῶν Ἰησοῦ Χριστοῦ, εἰς ἄφεσίν μου ἁμαρτιῶν καὶ εἰς ζωὴν αἰώνιον."
ruLI.Rubric_185a.text = "Καί, μεταλαβὼν ἐξ αὐτοῦ, ἀποσπογγίζει διὰ τοῦ μάκτρου τά τε ἴδια χείλη καὶ τὸ ἅγιον ποτήριον λέγων·"
ruLI.Rubric_186a.text = "Τοῦτο ἥψατο τῶν χειλέων μου καὶ ἀφελεῖ τὰς ἀνομίας μου καὶ τὰς ἁμαρτίας μου περικαθαριεῖ."
ruLI.Rubric_187a.text = "Καὶ τοῦτο εἰπών, προσκαλεῖ αὖθις τὸν Διάκονον λέγων·"
ruLI.Rubric_188a.text = "Διάκονε, ἔτι πρόσελθε."
ruLI.Rubric_189a.text = "Ἐλθὼν δὲ ὁ Διάκονος ἐξ ἀριστερῶν τοῦ Ἱερέως, ἔμπροσθεν τῆς ἁγίας Τραπέζης, ἀποσπογγίζει μετὰ τῆς μούσης τὴν παλάμην αὐτοῦ ἐπὶ τοῦ ἁγίου δίσκου μετὰ προσοχῆς καὶ λέγει·"
ruLI.Rubric_190a.text = "Ἔτι προσερχομένῳ μετάδος μοι, δέσποτα, (δεῖνι) τῷ ἀναξίῳ διακόνῳ τὸ τίμιον καὶ πανάγιον Αἷμα τοῦ Κυρίου καὶ Θεοῦ καὶ σωτῆρος ἡμῶν Ἰησοῦ Χριστοῦ, εἰς ἄφεσίν μου ἁμαρτιῶν καὶ εἰς ζωὴν αἰώνιον."
ruLI.Rubric_191a.text = "Καὶ ὁ Ἱερεὺς μεταδίδωσιν αὐτῷ ἐκ τοῦ ἁγίου ποτηρίου καὶ λέγει·"
ruLI.Rubric_192a.text = "Ἔτι μεταδίδοταί σοι (δεῖνι) τῷ εὐλαβεστάτῳ διακόνῳ τὸ τίμιον καὶ πανάγιον Αἷμα τοῦ Κυρίου καὶ Θεοῦ καὶ σωτῆρος ἡμῶν Ἰησοῦ Χριστοῦ, εἰς ἄφεσίν σου ἁμαρτιῶν καὶ εἰς ζωὴν αἰώνιον."
ruLI.Rubric_193a.text = "Ὁ δὲ Διάκονος ἀποσπογγίζει διὰ τοῦ μάκτρου τὰ ἴδια χείλη καὶ τὸ ἅγιον ποτήριον, τοῦ Ἱερέως λέγοντος·"
ruLI.Rubric_194a.text = "Τοῦτο ἥψατο τῶν χειλέων σου καὶ ἀφελεῖ τὰς ἀνομίας σου καὶ τὰς ἁμαρτίας σου περικαθαριεῖ."
ruLI.Rubric_195a.text = "Εἶτα ὁ Διάκονος προσκυνήσας λαμβάνει τὸν ἅγιον δίσκον διὰ τῆς ἀριστερᾶς χειρὸς καὶ διὰ τῶν δύο δακτύλων τῆς δεξιᾶς χειρὸς τὴν μοῦσαν· καὶ ἐμβάλλει εἰς τὸ ἅγιον ποτήριον μετὰ προσοχῆς καὶ εὐλαβείας πρῶτον τὰς μερίδας τοῦ ἁγίου Ἄρτου καὶ εἶτα τὰς λοιπάς, καὶ ἀποσπογγίζει καλῶς διὰ τῆς μούσης τὸν ἅγιον δίσκον καὶ τὸ εἰλητόν. Καὶ οὕτω σκεπάζει τὸ ἅγιον ποτήριον τῷ μάκτρῳ, ἐπὶ δὲ τοῦ ἁγίου δίσκου τίθησι τὸν ἀστερίσκον καὶ τὰ καλύμματα."
ruLI.Rubric_196a.text = "Ὁ δὲ Ἱερεύς, τὴν ἁγίαν λαβίδα ἐμβαλὼν τῷ ἁγίῳ ποτηρίῳ, ἐπαίρει καὶ δίδωσι τοῦτο κεκαλυμμένον τῷ Διακόνῳ, ὅστις ἔρχεται εἰς τὴν Ὡραίαν Πύλην καὶ δείκνυσιν αὐτὸ τῷ λαῷ λέγων·"
ruLI.Rubric_197a.text = "Ὁ Ἱερεὺς αἴρει ἀπὸ τῶν χειρῶν τοῦ Διακόνου τὸ ἅγιον ποτήριον καὶ μεταδίδωσιν ἑνὶ ἑκάστῳ τῶν προσελθόντων διὰ τῆς λαβίδος λέγων·"
ruLI.Rubric_197b.text = "Σῶμα καὶ Αἷμα Χριστοῦ, εἰς ἄφεσιν ἁμαρτιῶν καὶ εἰς ζωὴν αἰώνιον."
ruLI.Rubric_198a.text = "Μετὰ δὲ τὴν Θείαν Κοινωνίαν τῶν πιστῶν, ὁ Ἱερεὺς στραφεὶς πρὸς τὸν λαὸν ὑψῶν τὸ ἅγιον Ποτήριον καὶ λέγει ἐκφώνως·"
ruLI.Rubric_199a.text = "Καὶ εἰσελθόντες, ὁ μὲν Ἱερεὺς ἀποτίθησι τὸ ἅγιον ποτήριον ἐν τῇ ἁγίᾳ Τραπέζῃ καὶ εὐθέως λαμβάνει τὸ θυμιατήριον, ὁ δὲ Διάκονος λέγει πρὸς τὸν Ἱερέα·"
ruLI.Rubric_200a.text = "Ὁ δὲ Ἱερεὺς θυμιᾷ τρὶς λέγων·"
ruLI.Rubric_201a.text = "Εἶτα τὸν μὲν ἅγιον δίσκον μετὰ τῶν καλυμμάτων καὶ τοῦ ἀστερίσκου ἐπιδίδωσι τῷ Διακόνῳ, ὅστις κύκλῳ τῆς ἁγίας Τραπέζης ἐρχόμενος μεταφέρει καὶ ἀποτίθησιν αὐτὰ εἰς τὴν Πρόθεσιν. Ὁ δὲ Ἱερεὺς λαμβάνει τὸ ἅγιον ποτήριον καὶ λέγει ἡσύχως·"
ruLI.Rubric_202a.text = "Στρεφόμενος δὲ πρὸς τὸν λαόν, λέγει ἐκφώνως·"
ruLI.Rubric_203a.text = "Καὶ οὕτως ἀπέρχεται ὁ Ἱερεὺς εἰς τὴν Πρόθεσιν καὶ ἀποτίθησι τὸ ἅγιον ποτήριον."
ruLI.Rubric_204a.text = "Ὁ Διάκονος ἐξέρχεται καὶ στὰς πρὸ τῶν βημοθύρων λέγει·"
ruLI.Rubric_205a.text = "Ὁ Ἱερεὺς διπλώσας τὸ εἰλητόν, ἐπεύχεται τὴν εὐχαριστήριον εὐχήν·"
ruLI.Rubric_206a.text = "Ὁ Ἱερεὺς ἐκφώνως·"
ruLI.Rubric_207a.text = "Ταύτης τῆς ἐκφωνήσεως λεγομένης, λαμβάνει ὁ Ἱερεὺς τὸ ἱερὸν Εὐαγγέλιον καὶ ποιήσας διʼ αὐτοῦ τὸ σημεῖον τοῦ σταυροῦ ἐπὶ τοῦ διπλωθέντος ἤδη εἰλητοῦ καὶ ἀσπασάμενος ἐπιτίθησιν αὐτὸ ἐπʼ αὐτοῦ. Στραφεὶς δὲ πρὸς τὸν λαὸν ἐκφωνεῖ·"
ruLI.Rubric_208a.text = "Καὶ ὁ Ἱερεύς, ἐξελθὼν τῆς Ὡραίας Πύλης, ἔχων κεκαλυμμένην τὴν κεφαλὴν καὶ προσβλέπων πρὸς ἀνατολάς, ἀναγινώσκει εἰς ἐπήκοον πάντων τὴν εὐχήν."
ruLI.Rubric_209a.text = "Εἰσελθὼν δὲ ὁ Ἱερεὺς διὰ τῆς Ὡραίας Πύλης, ἔρχεται εἰς τὴν Πρόθεσιν καὶ λέγει τὴν εὐχὴν ταύτην·"
ruLI.Rubric_210a.text = "Εἶτα ὁ Διάκονος ἔσωθεν τοῦ ἁγίου Βήματος ἐκφωνεῖ·"
ruLI.Rubric_211a.text = "Ὁ Ἱερεύς, μεθιστάμενος τῆς θέσεως αὐτοῦ, ἵσταται πρὸ τῆς Ὡραίας Πύλης καί, προσβλέπων πρὸς τὸν λαόν, εὐλογεῖ αὐτὸν διὰ τῆς δεξιᾶς χειρὸς καὶ ἐκφωνεῖ·"
ruLI.Rubric_212a.text = "Ὁ Ἀναγνώστης· Δόξα, καὶ νῦν, Κύριε, ἐλέησον (γʹ), πάτερ ἅγιε, εὐλόγησον."
ruLI.Rubric_213a.text = "Ὁ δὲ Ἱερεὺς ποιεῖ τὴν μεγάλην Ἀπόλυσιν· καὶ ἐν μὲν τῇ Κυριακῇ ἄρχεται λέγων· Ὁ ἀναστὰς ἐκ νεκρῶν… ἢ ἐν Δεσποτικῇ ἑορτῇ τὸ χαρακτηριστικὸν αὐτῆς, ἐν ἄλλῃ δὲ ἡμέρᾳ·"
ruLI.Rubric_214a.text = "Χριστὸς ὁ ἀληθινὸς Θεὸς ἡμῶν, ταῖς πρεσβείαις τῆς παναχράντου καὶ παναμώμου ἁγίας αὐτοῦ Μητρός, δυνάμει τοῦ τιμίου καὶ ζωοποιοῦ Σταυροῦ, προστασίαις τῶν τιμίων ἐπουρανίων δυνάμεων ἀσωμάτων, ἱκεσίαις τοῦ τιμίου, ἐνδόξου, προφήτου, προδρόμου καὶ βαπτιστοῦ Ἰωάννου, τῶν ἁγίων ἐνδόξων καὶ πανευφήμων ἀποστόλων, τῶν ἁγίων ἐνδόξων καὶ καλλινίκων μαρτύρων· τῶν ὁσίων καὶ θεοφόρων πατέρων ἡμῶν· (τοῦ ἁγίου τοῦ ναοῦ) · τῶν ἁγίων καὶ δικαίων θεοπατόρων Ἰωακεὶμ καὶ Ἄννης, (τοῦ ἁγίου τῆς ἡμέρας, ἐὰν ἔχῃ Δοξαστικόν), οὗ καὶ τὴν μνήμην ἐπιτελοῦμεν, καὶ πάντων τῶν ἁγίων, ἐλεήσαι καὶ σώσαι ἡμᾶς, ὡς ἀγαθὸς καὶ φιλάνθρωπος."
ruLI.Rubric_215a.text = "Καὶ ἐπιλέγει τό·"
ruLI.Rubric_216a.text = "Οἱ Χοροί· Ἀμήν."
ruLI.Rubric_217a.text = "Καὶ αὖθις ὁ Ἱερεύς, εὐλογῶν τὸν λαόν, λέγει·"
ruLI.Rubric_218a.text = "Ἡ ἁγία Τριὰς διαφυλάξαι πάντας ὑμᾶς."
ruLI.Rubric_219a.text = "Καὶ ὁ μὲν Ἱερεὺς διανέμει τῷ λαῷ τὸ Ἀντίδωρον λέγων ἑνὶ ἑκάστῳ·"
ruLI.Rubric_220a.text = "Εὐλογία Κυρίου καὶ ἔλεος ἔλθοι ἐφʼ ὑμᾶς."
ruLI.Rubric_221a.text = "Ἐν τούτοις ὁ Διάκονος ἀπέρχεται ἐν τῇ ἁγίᾳ Προθέσει καὶ καταλύει τὰ ἅγια μετὰ φόβου καὶ πάσης ἀσφαλείας, ὥστε μηδέν τι τῶν ἄγαν λεπτοτάτων ἐκπεσεῖν ἢ καταλειφθῆναι. Εἶτα ἀπονίπτονται ἀμφότεροι τὰς χεῖρας καὶ τὰ χείλη ἐν τῷ χωνευτηρίῳ καὶ ἀπεκδυσάμενοι τὰ ἱερὰ ἄμφια αὐτῶν καὶ προσκυνήσαντες καὶ ἀσπασάμενοι τὴν ἁγίαν Τράπεζαν ἀπέρχονται εὐχαριστοῦντες τῷ Θεῷ."



ruLI.Note_01a.text = "Εἰ οὐκ ἔστι Διάκονος, ἅπαντα αὐτοῦ, πλὴν τῶν πρὸς τὸν Ἱερέα παρακελεύσεων· Εὐλόγησον, δέσποτα. Κέλευσον, δέσποτα, κ.τ.λ. καὶ τῶν μεταξὺ Διακόνου καὶ Ἱερέως διαλόγων, ἐκφωνεῖ ἔσωθεν τοῦ ἁγίου Βήματος ὁ Ἱερεύς."
ruLI.Note_02a.text = "Τὸ εἴς τινας ἱερατικὰς φυλλάδας «μυστικῶς» τὰς εὐχὰς ἀναγινώσκειν ἀπαντώμενον δὲν σημαίνει ἀφώνως, ἀλλὰ μὲ χαμηλόφωνον καὶ ἥσυχον τρόπον, τουτέστι μυσταγωγικόν. Ἡ Α.Θ. Παναγιότης, ὁ Οἰκουμενικὸς Πατριάρχης κ.κ. Βαρθολομαῖος ἀναφέρει· «Τὸ μυστικῶς ἀντιτάσσεται εἰς τὸ ἐκφώνως, δὲν ταυτίζεται μὲ τὸ σιωπηρῶς. Εἰδικῶς τὴν εὐχαριστιακὴν ἀναφοράν, τὴν ὁποίαν προσφέρει ὅλος ὁ λαὸς διὰ τοῦ στόματος τοῦ κληρικοῦ, τυγχάνει ἀδιανόητον νὰ τὴν ἀποσιωπῶμεν, περιοριζόμενοι εἰς μόνην τὴν Ἐκφώνησιν» (περιοδικὸν Ὀρθοδοξία, τεῦχος Δʹ, Ὀκτ. – Δεκ. 1994, σ. 721)."
ruLI.Note_03a.text = "On weekdays we sing: “who are wondrous in the saints.” Feasts of the Lord have their own refrain."
ruLI.Note_04a.text = "Οὐδέποτε Ἱερεὺς ἱερουργῶν μόνος ἢ μετὰ Διακόνου ψάλλει Εἰσοδικὸν καὶ τὰ τοῦ Συλλειτούργου, ἤτοι Ἀπολυτίκιον ἢ Κοντάκιον ἢ τὸν Τρισάγιον ὕμνον."
ruLI.Note_05a.text = "On weekdays we sing: “who are wondrous in the saints.” Feasts of the Lord have their own Entrance Hymn."
ruLI.Note_06a.text = "Ἐν ταῖς μεγάλαις Δεσποτικαῖς ἑορταῖς, ἤτοι ταῖς δυσὶν ἡμέραις τῆς ἑορτῆς τῶν Χριστουγέννων καὶ τῆς τῶν Θεοφανείων, τῷ Σαββάτῳ τοῦ Λαζάρου, τῷ Μεγάλῳ Σαββάτῳ, τῇ Κυριακῇ τοῦ ἁγίου Πάσχα καὶ τῇ Διακαινησίμῳ Ἑβδομάδι, τῇ Ἀποδόσει τοῦ Πάσχα, τῇ Κυριακῇ τῆς Πεντηκοστῆς καὶ τῇ Δευτέρᾳ τοῦ ἁγίου Πνεύματος, ψάλλεται ἀντὶ τοῦ Τρισαγίου τό· Ὅσοι εἰς Χριστὸν ἐβαπτίσθητε, Χριστὸν ἐνεδύσασθε. Ἀλληλούϊα. Ἐν δὲ τῇ ἑορτῇ τῆς ὑψώσεως τοῦ τιμίου Σταυροῦ καὶ τῇ Κυριακῇ τῆς Σταυροπροσκυνήσεως ψάλλεται τό· Τὸν Σταυρόν σου προσκυνοῦμεν, Δέσποτα, καὶ τὴν ἁγίαν σου ἀνάστασιν δοξάζομεν."
ruLI.Note_07a.text = "[How should this be said in English? “Master, command.” or “Master, give [the] direction.”]"
ruLI.Note_08a.text = "What does this mean?"
ruLI.Note_09a.text = "Κατὰ τὴν ἀρχαίαν τάξιν ὁ Διάκονος θυμιᾷ ψαλλομένου τοῦ· Ἀλληλούϊα."
ruLI.Note_10a.text = "Ps 67.12: Κύριος δώσει ρῆμα τοῖς εὐαγγελιζομένοις δυνάμει πολλῇ. SAAS: The Lord will give His word to those proclaiming the gospel with great power."
ruLI.Note_11a.text = "Lk 1:37"
ruLI.Note_12a.text = "«Διακόνου δὲ μὴ ὄντος, τὸ ἱερὸν Εὐαγγέλιον ἀναγινώσκει ὁ Ἱερεὺς ἀπὸ τῆς Ὡραίας Πύλης καὶ οὐχί ποτε ἀπὸ τοῦ Ἄμβωνος, ὥς τινες ἐν τοῖς τελευταίοις τούτοις χρόνοις ἐξ ἀγνοίας ἢ φιλοδοξίας ἀκαίρου ἠθέλησαν ἵνα εἰσαγάγωσι». Πρβλ. ΤΜΕ, σελ. 60, ὑποσημ. 4."
ruLI.Note_13a.text = "Ἐνταῦθα καὶ οὐχὶ εἰς τὸ Κοινωνικὸν ὁ Ἱερεὺς [ἢ ὁ Ἱεροκήρυξ, λαβὼν τὴν εὐλογίαν τοῦ Ἱερουργοῦντος, ἀνερχόμενος εἰς τὸν ἱερὸν Ἄμβωνα,] ἑρμηνεύει τὴν ἀναγνωσθεῖσαν Εὐαγγελικὴν ἢ Ἀποστολικὴν περικοπὴν καὶ ἐν γένει διδάσκει τὸν λαὸν εἰς γλῶσσαν ἁπλῆν καὶ καθαράν."
ruLI.Note_14a.text = "Οὐχὶ ὀρθῶς ἔχει ἐπικρατήσει, χάριν κακῶς ἐννοουμένης συντομίας, ἡ μυστικὴ ἀνάγνωσις τῆς Ἐκτενοῦς μετὰ τῆς εὐχῆς αὐτῆς, τῆς δεήσεως ὑπὲρ τῶν κατηχουμένων καὶ τῶν δύο εὐχῶν τῶν πιστῶν, καὶ ἡ εὐθὺς μετὰ τὸ Εὐαγγέλιον μετέωρος ἀπαγγελία τῆς ἐκφωνήσεως· Ὅπως ὑπὸ τοῦ κράτους σου…"
ruLI.Note_15a.text = "Τὰς αὐτὰς εὐχὰς ἀπευθύνουσιν ὁ Ἱερεὺς καὶ ὁ Διάκονος πρὸς παρισταμένους τυχὸν ἐν τῷ ἁγίῳ Βήματι Κληρικούς."
ruLI.Note_16a.text = "Ἀρχαιοτέρα γραφή· «σοὶ προσφέροντες»."
ruLI.Note_17a.text = "Τὰ Πληρωτικά, λεχθέντα καὶ πρότερον, δὲν ὑπῆρχον ἐξ ἀρχῆς εἰς τὸ σημεῖον τοῦτο, παρεισήχθησαν δὲ πιθανώτατα κατʼ ἐπίδρασιν τῆς Θείας Λειτουργίας τῶν Προηγιασμένων (βλ. Π. Τρεμπέλα, Αἱ τρεῖς Λειτουργίαι, σελ. 126, καὶ Ἰ. Φουντούλη, Βυζαντιναὶ Λειτουργίαι, σελ. 9), ὀρθῶς δὲ παραλείπονται συνήθως σήμερον."
ruLI.Note_18a.text = "See Rom. 12.11: τῷ πνεύματι ζέοντες. RSV: be aglow with the Spirit."
ruLI.Note_19a.text = "Εἴθισται, ὅπως λέγωνται ἐνταῦθα ὑπὸ τοῦ Ἱερέως καὶ τοῦ Διακόνου εὐχαὶ ἐκ τῆς ἀκολουθίας τῆς Θείας Μεταλήψεως· Πιστεύω, Κύριε, καὶ ὁμολογῶ… κτλ. Αἱ εὐχαὶ αὗται οὐκ ἀποτελοῦσι μέρος τῆς Θείας Λειτουργίας, ἀλλὰ νεωτέραν προσθήκην εἰς τὸ κείμενον αὐτῆς καὶ λέγονται ἐκ συνηθείας καὶ εὐλαβείας."
ruLI.Note_20a.text = "Ὀρθὸν εἶναι, ὅπως ἐμβάλλωνται εἰς τὸ ἅγιον ποτήριον κατὰ τὴν ὥραν ταύτην μόνον αἱ μερίδες τοῦ ἁγίου Ἄρτου, αἱ δὲ λοιπαὶ μετὰ τὴν μετάληψιν τοῦ λαοῦ καὶ μάλιστα ἐὰν εἶναι πολλοὶ οἱ μέλλοντες προσελθεῖν εἰς τὴν Θείαν Κοινωνίαν."
ruLI.Note_21a.text = "Κατὰ τὴν ἀρχαίαν τάξιν ἐν τῷ σημείῳ τούτῳ, ψάλλεται ὁ ὕμνος· Πληρωθήτω τὸ στόμα ἡμῶν αἰνέσεώς σου, Κύριε, ὅπως ὑμνήσωμεν τὴν δόξαν σου, ὅτι ἠξίωσας ἡμᾶς μετασχεῖν τῶν ἁγίων μυστηρίων σου· τήρησον ἡμᾶς ἐν τῷ σῷ ἁγιασμῷ, ὅλην τὴν ἡμέραν μελετᾶν τὴν δικαιοσύνην σου. Ἀλληλούϊα, ἀλληλούϊα, ἀλληλούϊα."
ruLI.Note_22a.text = "Βλ. ὑπος. 7, σελ 44. [Ἐὰν ὁ ναὸς τιμᾶται ἐπʼ ὀνόματι τῆς ἁγίας Τριάδος, ἢ τοῦ σωτῆρος Χριστοῦ ἢ τῆς Θεοτόκου ἢ τοῦ τιμίου Σταυροῦ ἢ τῶν Ταξιαρχῶν ἢ τοῦ Προδρόμου, παραλείπεται ἡ μνημόνευσις τοῦ ἁγίου τοῦ ναοῦ. Ἐὰν δὲ ἡ ἀγομένη ἑορτὴ εἶναι Δεσποτική, δὲν μνημονεύεται αὕτη κατὰ τὴν μνημόνευσιν τοῦ ἁγίου τῆς ἡμέρας, διότι ἡ ἀναφορὰ τῆς ἑορτῆς ἐγένετο ἐν τῇ ἀρχῇ τῆς Ἀπολύσεως. Ἐπίσης, παραλείπεται ἡ φράσις· τοῦ ἁγίου (τῆς ἡμέρας), οὗ καὶ τὴν μνήμην ἐπιτελοῦμεν, ἐὰν ἄγηται ἑορτὴ Θεομητορική, ἢ τοῦ τιμίου Σταυροῦ, ἢ τῶν Ταξιαρχῶν, ἢ οἱαδήποτε ἐκ τῶν ἑορτῶν τοῦ Προδρόμου, διότι ἐν τῷ ἀνωτέρω τύπῳ τῆς Ἀπολύσεως ἐγένετο ἤδη μνεία τῆς Θεοτόκου, τοῦ τιμίου Σταυροῦ, τῶν Ταξιαρχῶν καὶ του Προδρόμου.]"


